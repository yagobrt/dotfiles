#!/usr/bin/env bash

## For the server

set -Eeuo pipefail

cd /opt/timetagger

BACKUP_DIR=/home/ubuntu/backups
STAMP="$(date +%F-%H%M%S)"
ARCHIVE="$BACKUP_DIR/timetagger-$STAMP.tar.gz"

mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

# Ensure TimeTagger is restarted even if the backup fails.
trap 'docker compose start timetagger >/dev/null || true' EXIT

docker compose stop timetagger

tar -czf "$ARCHIVE" -C /opt/timetagger data

chown ubuntu:ubuntu "$ARCHIVE"
chmod 600 "$ARCHIVE"

# Remove server-side archives older than 14 days.
find "$BACKUP_DIR" -maxdepth 1 -type f \
    -name 'timetagger-*.tar.gz' -mmin +20160 -delete

docker compose start timetagger
trap - EXIT

echo "Backup created: $ARCHIVE"
